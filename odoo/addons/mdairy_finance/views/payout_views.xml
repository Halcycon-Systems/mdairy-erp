<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Payout Batch List -->
    <record id="mdairy_payout_batch_list_view" model="ir.ui.view">
        <field name="name">mdairy.payout.batch.list</field>
        <field name="model">mdairy.payout.batch</field>
        <field name="arch" type="xml">
            <list string="Payout Batches"
                  decoration-success="state=='disbursed'"
                  decoration-info="state=='approved'"
                  decoration-warning="state=='computed'">
                <field name="name"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="cooperative_id"/>
                <field name="payout_count"/>
                <field name="total_gross" sum="Total Gross"/>
                <field name="total_deductions" sum="Total Deductions"/>
                <field name="total_net" sum="Total Net"/>
                <field name="state" widget="badge"
                       decoration-success="state=='disbursed'"
                       decoration-info="state in ['approved','computed']"
                       decoration-danger="state=='cancelled'"
                       decoration-muted="state=='draft'"/>
            </list>
        </field>
    </record>

    <!-- Payout Batch Form -->
    <record id="mdairy_payout_batch_form_view" model="ir.ui.view">
        <field name="name">mdairy.payout.batch.form</field>
        <field name="model">mdairy.payout.batch</field>
        <field name="arch" type="xml">
            <form string="Payout Batch">
                <header>
                    <button name="action_compute_payouts" string="Compute Payouts"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve"
                            type="object" class="oe_highlight"
                            invisible="state != 'computed'"/>
                    <button name="action_disburse" string="Disburse Payouts"
                            type="object" class="oe_highlight"
                            invisible="state != 'approved'"/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state in ['disbursed','cancelled']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,computed,approved,disbursed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="cooperative_id"/>
                        </group>
                        <group string="Totals">
                            <field name="total_gross"/>
                            <field name="total_deductions"/>
                            <field name="total_net"/>
                            <field name="payout_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Farmer Payouts">
                            <field name="payout_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="farmer_id"/>
                                    <field name="total_litres"/>
                                    <field name="gross_amount" sum="Gross"/>
                                    <field name="total_deductions" sum="Deductions"/>
                                    <field name="amount" sum="Net"/>
                                    <field name="payout_method"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Individual Payout Form -->
    <record id="mdairy_payout_form_view" model="ir.ui.view">
        <field name="name">mdairy.payout.form</field>
        <field name="model">mdairy.payout</field>
        <field name="arch" type="xml">
            <form string="Farmer Payout">
                <header>
                    <button name="action_mark_paid" string="Mark as Paid"
                            type="object" class="oe_highlight"
                            invisible="state != 'approved'"/>
                    <button name="action_mark_failed" string="Mark as Failed"
                            type="object"
                            invisible="state not in ['approved']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="farmer_id"/>
                            <field name="batch_id"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="total_litres"/>
                        </group>
                        <group string="Financial">
                            <field name="gross_amount"/>
                            <field name="total_deductions"/>
                            <field name="amount"/>
                        </group>
                    </group>
                    <group string="Payment Details">
                        <field name="payout_method"/>
                        <field name="mpesa_number" invisible="payout_method != 'mpesa'"/>
                        <field name="bank_name" invisible="payout_method != 'bank'"/>
                        <field name="bank_account_number" invisible="payout_method != 'bank'"/>
                        <field name="payment_date"/>
                        <field name="transaction_reference"/>
                    </group>
                    <notebook>
                        <page string="Deductions">
                            <field name="deduction_line_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="deduction_id"/>
                                    <field name="amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Collections Included">
                            <field name="collection_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="collection_date"/>
                                    <field name="session"/>
                                    <field name="quantity_litres"/>
                                    <field name="quality_grade"/>
                                    <field name="amount_due"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Payout Actions -->
    <record id="action_mdairy_payout_batch" model="ir.actions.act_window">
        <field name="name">Payout Batches</field>
        <field name="res_model">mdairy.payout.batch</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_mdairy_payout" model="ir.actions.act_window">
        <field name="name">Farmer Payouts</field>
        <field name="res_model">mdairy.payout</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
