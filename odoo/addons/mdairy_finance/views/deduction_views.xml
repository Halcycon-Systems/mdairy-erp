<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Deduction List -->
    <record id="mdairy_deduction_list_view" model="ir.ui.view">
        <field name="name">mdairy.deduction.list</field>
        <field name="model">mdairy.deduction</field>
        <field name="arch" type="xml">
            <list string="Deductions" editable="bottom">
                <field name="farmer_id"/>
                <field name="name"/>
                <field name="deduction_type"/>
                <field name="fixed_amount" optional="show"/>
                <field name="percentage" optional="show"/>
                <field name="loan_balance" optional="show"/>
                <field name="monthly_repayment" optional="show"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state" widget="badge"
                       decoration-success="state=='active'"
                       decoration-muted="state in ['completed','suspended']"/>
            </list>
        </field>
    </record>

    <record id="action_mdairy_deduction" model="ir.actions.act_window">
        <field name="name">Deductions</field>
        <field name="res_model">mdairy.deduction</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
