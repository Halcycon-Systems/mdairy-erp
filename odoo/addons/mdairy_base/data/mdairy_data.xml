<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequences -->
    <record id="seq_mdairy_farmer" model="ir.sequence">
        <field name="name">Farmer Sequence</field>
        <field name="code">mdairy.farmer</field>
        <field name="prefix">FMR/</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_mdairy_cooperative" model="ir.sequence">
        <field name="name">Cooperative Sequence</field>
        <field name="code">mdairy.cooperative</field>
        <field name="prefix">COOP/</field>
        <field name="padding">4</field>
    </record>
</odoo>
