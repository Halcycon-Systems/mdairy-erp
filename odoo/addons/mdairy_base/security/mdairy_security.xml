<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Groups -->
    <record id="group_mdairy_user" model="res.groups">
        <field name="name">mDairy / User</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_mdairy_manager" model="res.groups">
        <field name="name">mDairy / Manager</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('group_mdairy_user'))]"/>
    </record>
</odoo>
