<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Farmer List View -->
    <record id="mdairy_farmer_list_view" model="ir.ui.view">
        <field name="name">mdairy.farmer.list</field>
        <field name="model">mdairy.farmer</field>
        <field name="arch" type="xml">
            <list string="Farmers" decoration-info="state=='draft'"
                  decoration-success="state=='active'"
                  decoration-warning="state=='suspended'"
                  decoration-muted="state=='inactive'">
                <field name="farmer_code"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="cooperative_id"/>
                <field name="collection_centre_id"/>
                <field name="payout_method"/>
                <field name="total_collections" string="Total (Ltrs)"/>
                <field name="total_payouts" string="Total Paid (KES)"/>
                <field name="state" widget="badge"
                       decoration-info="state=='draft'"
                       decoration-success="state=='active'"
                       decoration-warning="state=='suspended'"
                       decoration-danger="state=='inactive'"/>
            </list>
        </field>
    </record>

    <!-- Farmer Form View -->
    <record id="mdairy_farmer_form_view" model="ir.ui.view">
        <field name="name">mdairy.farmer.form</field>
        <field name="model">mdairy.farmer</field>
        <field name="arch" type="xml">
            <form string="Farmer">
                <header>
                    <button name="action_activate" string="Activate"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_suspend" string="Suspend"
                            type="object"
                            invisible="state not in ['active']"/>
                    <button name="action_deactivate" string="Deactivate"
                            type="object"
                            invisible="state == 'inactive'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,suspended,inactive"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(mdairy_collection.action_mdairy_collection)d"
                                type="action" class="oe_stat_button" icon="fa-tint"
                                context="{'search_default_farmer_id': active_id}">
                            <field name="total_collections" widget="statinfo" string="Litres"/>
                        </button>
                        <button name="%(mdairy_finance.action_mdairy_payout)d"
                                type="action" class="oe_stat_button" icon="fa-money"
                                context="{'search_default_farmer_id': active_id}">
                            <field name="total_payouts" widget="statinfo" string="Paid (KES)"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="farmer_code"/>
                        <h1><field name="farmer_code" readonly="1"/></h1>
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Personal Information">
                            <field name="id_number"/>
                            <field name="date_of_birth"/>
                            <field name="gender"/>
                        </group>
                        <group string="Contact">
                            <field name="phone"/>
                            <field name="phone2"/>
                            <field name="email"/>
                        </group>
                    </group>
                    <group>
                        <group string="Location">
                            <field name="county"/>
                            <field name="sub_county"/>
                            <field name="ward"/>
                            <field name="village"/>
                            <field name="gps_latitude"/>
                            <field name="gps_longitude"/>
                        </group>
                        <group string="Cooperative / Centre">
                            <field name="cooperative_id"/>
                            <field name="collection_centre_id"
                                   domain="[('cooperative_id','=',cooperative_id)]"/>
                            <field name="registration_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Farm Details">
                            <field name="farm_size_acres"/>
                            <field name="number_of_cows"/>
                            <field name="animal_breed"/>
                        </group>
                        <group string="Payout Details">
                            <field name="payout_method"/>
                            <field name="mpesa_number"
                                   invisible="payout_method != 'mpesa'"/>
                            <field name="bank_name"
                                   invisible="payout_method != 'bank'"/>
                            <field name="bank_account_number"
                                   invisible="payout_method != 'bank'"/>
                            <field name="bank_branch"
                                   invisible="payout_method != 'bank'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Collection History">
                            <field name="collection_ids" readonly="1">
                                <list>
                                    <field name="collection_date"/>
                                    <field name="session"/>
                                    <field name="quantity_litres"/>
                                    <field name="quality_grade"/>
                                    <field name="unit_price"/>
                                    <field name="amount_due"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payout History">
                            <field name="payout_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="period_start"/>
                                    <field name="period_end"/>
                                    <field name="amount"/>
                                    <field name="payout_method"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Farmer Search View -->
    <record id="mdairy_farmer_search_view" model="ir.ui.view">
        <field name="name">mdairy.farmer.search</field>
        <field name="model">mdairy.farmer</field>
        <field name="arch" type="xml">
            <search string="Search Farmers">
                <field name="name"/>
                <field name="farmer_code"/>
                <field name="phone"/>
                <field name="id_number"/>
                <field name="cooperative_id"/>
                <field name="collection_centre_id"/>
                <filter string="Active" name="active" domain="[('state','=','active')]"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Suspended" name="suspended" domain="[('state','=','suspended')]"/>
                <group expand="0" string="Group By">
                    <filter string="Cooperative" name="group_cooperative"
                            context="{'group_by': 'cooperative_id'}"/>
                    <filter string="Collection Centre" name="group_centre"
                            context="{'group_by': 'collection_centre_id'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Payout Method" name="group_payout"
                            context="{'group_by': 'payout_method'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Farmer Action -->
    <record id="action_mdairy_farmer" model="ir.actions.act_window">
        <field name="name">Farmers</field>
        <field name="res_model">mdairy.farmer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="mdairy_farmer_search_view"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first farmer!
            </p>
            <p>
                Manage dairy farmer profiles, farm details, and payout methods.
            </p>
        </field>
    </record>
</odoo>
